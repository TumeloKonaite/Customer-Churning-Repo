{
  "policy_version": "1.0.0",
  "enabled": true,
  "minimum_current_rows": 200,
  "maximum_current_rows": 10000,
  "initial_lookback_hours": 24,
  "maximum_lookback_hours": 720,
  "fixed_historical_boundary": null,
  "minimum_reference_rows": 500,
  "schedule_cron": "15 */6 * * *",
  "cadence_minutes": 360,
  "data_latency_allowance_minutes": 30,
  "included_environments": ["development", "staging", "production"],
  "included_model_versions": ["*"],
  "drift_dataset_share_threshold": 0.3,
  "numeric_drift_method": "ks",
  "numeric_drift_threshold": 0.05,
  "categorical_drift_method": "chisquare",
  "categorical_drift_threshold": 0.05,
  "prediction_probability_drift_method": "ks",
  "prediction_probability_drift_threshold": 0.05,
  "predicted_class_drift_method": "chisquare",
  "predicted_class_drift_threshold": 0.05,
  "row_count_change_warning_ratio": 0.5,
  "excluded_features": [],
  "suppressed_features": [],
  "exclusion_rules": [],
  "suppression_rules": [],
  "feature_rules": {
    "CreditScore": {"data_type": "integer", "nullable": false, "minimum": 300, "maximum": 850},
    "Geography": {"data_type": "string", "nullable": false, "allowed_values": ["France", "Germany", "Spain"]},
    "Gender": {"data_type": "string", "nullable": false, "allowed_values": ["Female", "Male"]},
    "Age": {"data_type": "integer", "nullable": false, "minimum": 18, "maximum": 100},
    "Tenure": {"data_type": "integer", "nullable": false, "minimum": 0, "maximum": 10},
    "Balance": {"data_type": "number", "nullable": false, "minimum": 0},
    "NumOfProducts": {"data_type": "integer", "nullable": false, "minimum": 1, "maximum": 4},
    "HasCrCard": {"data_type": "integer", "nullable": false, "allowed_values": [0, 1]},
    "IsActiveMember": {"data_type": "integer", "nullable": false, "allowed_values": [0, 1]},
    "EstimatedSalary": {"data_type": "number", "nullable": false, "minimum": 0}
  },
  "calibration_note": "All initial row limits, ranges, drift methods, and thresholds are hypotheses. Calibrate them from observed production volume and distributions; any result-affecting change requires a new policy version."
}
