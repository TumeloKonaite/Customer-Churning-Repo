# Never put real credentials in this file. Copy it to an untracked .env locally.
APP_ENV=development

MLFLOW_EXPERIMENT_NAME=customer-churn-production

# MLflow remains the logging API; DagsHub is the only supported backend.
ENABLE_DAGSHUB_TRACKING=false
DAGSHUB_REPO_OWNER=
DAGSHUB_REPO_NAME=
DAGSHUB_TOKEN=

# Production publication only. This requires DagsHub tracking above.
ENABLE_MODEL_REGISTRATION=false
MLFLOW_REGISTERED_MODEL_NAME=churn_predictor

DATABASE_URL=postgresql+psycopg://<runtime-role>:<password>@<pooled-host>/churn_monitoring?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1

# Required only by an exact-version production deployment.
MLFLOW_MODEL_VERSION=<numeric-version>
EXPECTED_MLFLOW_RUN_ID=<run-id>
EXPECTED_MODEL_VERSION_ID=dagshub:<owner>/<repository>:churn_predictor:<numeric-version>
EXPECTED_PIPELINE_SHA256=<sha256>
EXPECTED_ARTIFACT_MANIFEST_SHA256=<sha256>
DEPLOYMENT_PACKAGE_DIR=build/model

# Monitoring workers only. In production use an immutable/versioned S3-compatible bucket.
MONITORING_ARTIFACT_BUCKET=<bucket-name>
MONITORING_ARTIFACT_ENDPOINT_URL=
MONITORING_ARTIFACT_REGION=<region>
# Local debugging alternative to MONITORING_ARTIFACT_BUCKET (never production).
# MONITORING_LOCAL_ARTIFACT_DIR=artifacts/monitoring

# Protected outcome ingestion and reproducible label/performance jobs.
CUSTOMER_TOKEN_HMAC_SECRET=<at-least-32-random-bytes>
CUSTOMER_TOKEN_KEY_ID=<non-secret-key-version>
OUTCOME_INGESTION_API_KEY=<at-least-24-random-characters>
OUTCOME_ALLOWED_REAL_SOURCES=customer-master
REQUIRED_OUTCOME_SOURCES=customer-master
LABEL_CONTRACT_VERSION=1.0.0
# Set true only after the approval record in the monitoring contract is complete.
LABEL_CONTRACT_APPROVED=false
MONITORING_POLICY_VERSION=1.0.0
PREDICTION_HORIZON_DAYS=90
LABEL_GRACE_PERIOD_DAYS=7
MONITORING_DEPLOYMENT_IDS=<deployment-id>
PERFORMANCE_COHORT_DAYS=30
DEPLOYED_CLASSIFICATION_THRESHOLD=0.5
MONITORING_MINIMUM_PRIVACY_SIZE=20
