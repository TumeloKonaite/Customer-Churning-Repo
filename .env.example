# Never put real credentials in this file. Copy it to an untracked .env locally.
APP_ENV=development

MLFLOW_EXPERIMENT_NAME=customer-churn-production

# MLflow remains the logging API; DagsHub is the only supported backend.
ENABLE_DAGSHUB_TRACKING=false
DAGSHUB_REPO_OWNER=
DAGSHUB_REPO_NAME=
DAGSHUB_TOKEN=

# Production publication only. This requires DagsHub tracking above.
ENABLE_MODEL_REGISTRATION=false
MLFLOW_REGISTERED_MODEL_NAME=churn_predictor

DATABASE_URL=postgresql+psycopg://<runtime-role>:<password>@<pooled-host>/churn_monitoring?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1

# Required only by an exact-version production deployment.
MLFLOW_MODEL_VERSION=<numeric-version>
EXPECTED_MLFLOW_RUN_ID=<run-id>
EXPECTED_MODEL_VERSION_ID=dagshub:<owner>/<repository>:churn_predictor:<numeric-version>
EXPECTED_PIPELINE_SHA256=<sha256>
EXPECTED_ARTIFACT_MANIFEST_SHA256=<sha256>
DEPLOYMENT_PACKAGE_DIR=build/model
